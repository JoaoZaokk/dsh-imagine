{
  "name": "dsh-imagine",
  "version": "0.4.0",
  "description": "Gemini for the DeepSeek Harness: generate images, speak, transcribe and talk live. Tools for the agent and routes for the phone app.",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "gemini",
    "image-generation",
    "tts",
    "stt",
    "speech",
    "live"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "scripts/*.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "live": "node scripts/live-smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoaoZaokk/dsh-imagine.git"
  },
  "homepage": "https://github.com/JoaoZaokk/dsh-imagine#readme",
  "bugs": {
    "url": "https://github.com/JoaoZaokk/dsh-imagine/issues"
  }
}
